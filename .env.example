# =====================================================================
# Shende Industries Enterprise Portal — Environment Configuration
# =====================================================================

NODE_ENV=production
PORT=5000

# ---------------------------------------------------------------------
# Database Configuration
# Option A: Cloud Database (Vercel Postgres / Neon / Supabase / Railway)
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_sample@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://neondb_owner:npg_sample@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Standard / Local Host
DB_HOST=localhost
DB_PORT=5432
DB_NAME=timetrakpro
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=false

# ---------------------------------------------------------------------
# JWT Security Tokens
# Generate random 64-char strings for production
# ---------------------------------------------------------------------
JWT_SECRET=shende_industries_jwt_secret_enterprise_2026_super_key
JWT_REFRESH_SECRET=shende_industries_jwt_refresh_secret_enterprise_2026_super_key
JWT_EXPIRE=1d
JWT_REFRESH_EXPIRE=7d

# ---------------------------------------------------------------------
# Client / Frontend URL (For CORS when hosted separately)
# ---------------------------------------------------------------------
FRONTEND_URL=https://shende-tracker.vercel.app
VITE_API_URL=/api
